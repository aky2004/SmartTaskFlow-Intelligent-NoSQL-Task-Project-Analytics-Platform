{
  "name": "smart-taskflow",
  "version": "1.0.0",
  "description": "SmartTaskFlow – Intelligent NoSQL Task & Project Analytics Platform (CSE494)",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
